              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 4xx (client error)\", () => pm.expect(pm.response.code).to.be.within(400, 499));",
                  "pm.test(\"Status code is 400\", () => pm.expect(pm.response.code).to.be.oneOf([400]));",
                  "pm.test(\"Error message mentions 'missing password'\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"error\");",
                  "    pm.expect(json.error.toLowerCase()).to.include(\"missing password\");",

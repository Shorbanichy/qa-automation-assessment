{
  "name": "saucedemo-reqres-automation",
  "version": "1.0.0",
  "private": true,
  "description": "UI (Playwright) + API (Postman/Newman) automation assessment",
  "scripts": {
    "test:q1": "playwright test tests/q1-locked-out-user.spec.ts",
    "test:q2": "playwright test tests/q2-standard-user-checkout.spec.ts",
    "test:q3": "playwright test tests/q3-performance-glitch-user.spec.ts",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "api:test": "newman run postman/reqres.postman_collection.json -e postman/reqres.postman_environment.json -r cli,htmlextra,json --reporter-htmlextra-export reports/newman/api-report.html --reporter-json-export reports/newman/api-report.json",
    "test:all": "node scripts/run-all.js",
    "report:html": "playwright show-report",
    "report:api": "node scripts/open-api-report.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "typescript": "^5.6.0"
  }
}
